{
  "name": "universal-playwright-automation-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise Playwright + TypeScript + Cucumber BDD automation framework (UI, API, UI+API) with a healthcare reference domain.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --import tsx tools/run/run-cucumber.ts",
    "test:framework": "cross-env TEST_ENV=local node --import tsx tools/run/run-cucumber.ts --profile framework",
    "test:healthcare": "cross-env TEST_ENV=local node --import tsx tools/run/run-cucumber.ts --profile healthcare",
    "test:smoke": "node --import tsx tools/run/run-cucumber.ts --profile smoke",
    "test:regression": "node --import tsx tools/run/run-cucumber.ts --profile regression",
    "test:ui": "node --import tsx tools/run/run-cucumber.ts --profile ui",
    "test:api": "node --import tsx tools/run/run-cucumber.ts --profile api",
    "test:integration": "node --import tsx tools/run/run-cucumber.ts --profile integration",
    "test:unit": "node --import tsx --test --test-reporter=spec \"tests/unit/**/*.test.ts\"",
    "bdd:check": "cross-env TEST_ENV=local cucumber-js --profile dryRun",
    "bdd:usage": "cross-env TEST_ENV=local cucumber-js --profile usage",
    "bdd:unused": "cross-env TEST_ENV=local cucumber-js --profile usageJson && node --import tsx tools/bdd/unused-steps.ts reports/bdd/usage.json",
    "bdd:lint": "node --import tsx tools/gherkin-lint/cli.ts features config/gherkin-lint.json",
    "report:analyze": "node --import tsx tools/failure-analysis/cli.ts",
    "report:allure": "cross-env NODE_OPTIONS=--import=tsx allure generate --config allurerc.mjs --clean",
    "report:open": "cross-env NODE_OPTIONS=--import=tsx allure open --config allurerc.mjs",
    "report": "npm run report:analyze && npm run report:allure",
    "traceability": "node --import tsx tools/traceability/cli.ts generate",
    "traceability:check": "node --import tsx tools/traceability/cli.ts check",
    "reference-app": "node --import tsx reference-app/start.ts",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "arch:check": "depcruise src tests tools reference-app --config .dependency-cruiser.cjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run arch:check && npm run test:unit && npm run bdd:lint && npm run traceability:check && npm run bdd:check && npm run bdd:unused",
    "playwright:install": "playwright install"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.3.0",
    "@cucumber/gherkin": "42.0.1",
    "@cucumber/messages": "34.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "allure": "3.22.1",
    "allure-cucumberjs": "3.14.0",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.0",
    "dotenv": "18.0.9",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "zod": "4.6.7"
  }
}
