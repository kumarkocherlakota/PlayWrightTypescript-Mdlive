{
  "ui": {
    "baseUrl": "http://localhost:4000",
    "headless": true
  },
  "api": {
    "baseUrl": "http://localhost:4000/api"
  },
  "auth": {
    "baseUrl": "http://localhost:4000/auth"
  },
  "logging": {
    "level": "debug"
