# Copy to .env for local runs. .env is git-ignored. Never commit real values.
# In CI, provide these as repository/environment secrets or variables.

# ---- Environment selection -------------------------------------------------
# One of the files in config/environments (local, dev, qa, staging). Default: qa
TEST_ENV=

# ---- Service endpoints (required for dev, qa and staging) -------------------
UI_BASE_URL=
API_BASE_URL=
AUTH_BASE_URL=

# ---- Synthetic test user (secrets) ------------------------------------------
# Use a dedicated synthetic account. Never use a real member or patient account.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# ---- Optional overrides -----------------------------------------------------
# BROWSER=chromium|firefox|webkit
# BROWSER_CHANNEL=chrome|msedge
# DEVICE=iPhone 15
# HEADLESS=true|false
# SLOW_MO_MS=0
# LOCALE=en-US
# TIMEZONE=UTC
# LOG_LEVEL=debug|info|warn|error
# LOG_TO_CONSOLE=true|false
# STEP_TIMEOUT_MS=60000
# TRACE=off|on|retain-on-failure
# VIDEO=off|on|retain-on-failure
# SCREENSHOT=off|on|only-on-failure
# ARTIFACTS_DIR=reports
# SECURITY_AUTHORIZED_HOSTS=qa.example.test,api.qa.example.test
# REFERENCE_APP_AUTOSTART=true|false   (local environment only; starts the synthetic app)
# TEST_RUN_ID=

# ---- Runner switches (read by cucumber.mjs) ---------------------------------
# CI=true enables retries
# RETRIES=2
# PARALLEL_WORKERS=4
# TAGS="@smoke and not @wip"
